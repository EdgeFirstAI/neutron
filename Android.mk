LOCAL_PATH := $(my-dir)

ifneq ($(filter IMX95 IMX943, $(BOARD_SOC_TYPE)),)
include $(CLEAR_VARS)
LOCAL_MODULE := NeutronFirmware.elf
LOCAL_MODULE_TAGS := optional
LOCAL_MODULE_CLASS := EXECUTABLES
LOCAL_VENDOR_MODULE := true
LOCAL_CHECK_ELF_FILES := false
LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR)/firmware
ifeq ($(BOARD_SOC_TYPE),IMX95)
LOCAL_SRC_FILES := imx95/firmware/$(LOCAL_MODULE)
else ifeq ($(BOARD_SOC_TYPE),IMX943)
LOCAL_SRC_FILES := imx943/firmware/$(LOCAL_MODULE)
endif
include $(BUILD_PREBUILT)

include $(CLEAR_VARS)
LOCAL_MODULE := libNeutronDriver
LOCAL_MODULE_SUFFIX :=.so
LOCAL_MODULE_TAGS := optional
LOCAL_MODULE_CLASS := SHARED_LIBRARIES
LOCAL_VENDOR_MODULE := true
LOCAL_CHECK_ELF_FILES := false
LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR)/lib64/
ifeq ($(BOARD_SOC_TYPE),IMX95)
LOCAL_SRC_FILES := imx95/library/$(LOCAL_MODULE)$(LOCAL_MODULE_SUFFIX)
else ifeq ($(BOARD_SOC_TYPE),IMX943)
LOCAL_SRC_FILES := imx943/library/$(LOCAL_MODULE)$(LOCAL_MODULE_SUFFIX)
endif
include $(BUILD_PREBUILT)

include $(CLEAR_VARS)
LOCAL_MODULE := libneutron_delegate
LOCAL_MODULE_SUFFIX :=.so
LOCAL_MODULE_TAGS := optional
LOCAL_MODULE_CLASS := SHARED_LIBRARIES
LOCAL_VENDOR_MODULE := true
LOCAL_CHECK_ELF_FILES := false
LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR)/lib64/
ifeq ($(BOARD_SOC_TYPE),IMX95)
LOCAL_SRC_FILES := imx95/library/$(LOCAL_MODULE)$(LOCAL_MODULE_SUFFIX)
else ifeq ($(BOARD_SOC_TYPE),IMX943)
LOCAL_SRC_FILES := imx943/library/$(LOCAL_MODULE)$(LOCAL_MODULE_SUFFIX)
endif
include $(BUILD_PREBUILT)

endif

